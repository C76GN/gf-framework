[sub_resource type="Shader" id="project_shader"]
code = "shader_type canvas_item;
render_mode unshaded;
uniform sampler2D source_image : source_color, repeat_disable, filter_linear;
uniform sampler2D destination_image : source_color, repeat_disable, filter_linear;
uniform float phase = 0.0;

void fragment() {
	COLOR = mix(texture(source_image, UV), texture(destination_image, UV), phase);
}"

