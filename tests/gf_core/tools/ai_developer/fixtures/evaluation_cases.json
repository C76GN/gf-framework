    {
      "id": "framework_bug_with_reproduction",
      "candidate": {
        "schema_version": 1,
        "title": "Async result completes twice",
        "summary": "A minimal project observes two terminal callbacks from one GF operation.",
        "expected": "Exactly one terminal callback.",
        "actual": "Both success and cancellation callbacks run.",
        "reproduction_steps": [
          "Create one operation.",
          "Cancel while its backend completes."
        ],
        "evidence": [
          {
            "kind": "minimal_reproduction",
            "text": "The minimal reproduction contains no project business systems."
          }
        ],
        "environment": {
          "godot_version": "4.5",
          "gf_version": "",
          "platform": "Windows",
          "packages": [
            "gf.kernel"
          ]
        },
        "suspected_scope": "framework",
        "requested_change": "",
        "impact": "high",
        "workaround": "Ignore the second callback."
      },
      "classification": "framework_bug",
      "eligible": true
    },
