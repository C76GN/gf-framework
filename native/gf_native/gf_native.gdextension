[configuration]
entry_symbol = "gf_native_init"
compatibility_minimum = "4.6"
reloadable = false

[libraries]
windows.x86_64 = "./bin/gf_native.dll"
linux.x86_64 = "./bin/linux-x86_64/libgf_native.so"
android.arm64 = "./bin/android-arm64/libgf_native.so"
android.x86_64 = "./bin/android-x86_64/libgf_native.so"
macos.arm64 = "./bin/macos-arm64/libgf_native.dylib"
ios.arm64 = "./bin/libgf_native.xcframework"

[dependencies]
windows.x86_64 = {
    "./GF-NATIVE-NOTICES.txt": "",
    "./RUST-STDLIB-NOTICES.html": ""
}
