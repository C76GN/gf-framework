<class name="GFStorageConflictReport" path="addons/gf/standard/utilities/storage/gf_storage_conflict_report.gd" module="standard" extends="RefCounted" classDigest="0d5892d13e6b8c19b81344875ba55ba52cdfbc07572dfc3eb47dc0e329074ec7">
	<description>GFStorageConflictReport: 冻结的记录冲突与显式解决候选。
载荷只能通过显式 getter 读取；to_dict() 不包含身份、revision 或业务数据。
revision 只能比较相等。报告不执行写入，也不证明解决候选已提交。</description>
	<tags>
		<tag name="api">public</tag>
		<tag name="category">value_object</tag>
		<tag name="since">3.17.0</tag>
	</tags>
	<signals />
	<enums>
		<member kind="enum" name="Resolution">
			<signature>enum Resolution {
	## 尚未决定。
	UNRESOLVED,
	## 选择本地候选。
	USE_LOCAL,
	## 选择远端候选。
	USE_REMOTE,
	## 使用项目合并候选。
	MERGED,
	## 跳过冲突。
	SKIPPED,
}</signature>
			<description>候选的解决方式，不代表持久化结果。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="since">unreleased</tag>
			</tags>
		</member>
	</enums>
