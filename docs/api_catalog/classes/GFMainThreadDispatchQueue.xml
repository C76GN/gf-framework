			<tags>
				<tag name="api">public</tag>
				<tag name="return">队列长度。</tag>
				<tag name="since">7.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="is_empty">
			<signature>func is_empty() -&gt; bool:</signature>
			<description>检查队列是否为空。</description>
			<tags>
				<tag name="api">public</tag>
