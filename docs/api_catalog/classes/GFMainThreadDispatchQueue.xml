			<tags>
				<tag name="api">public</tag>
				<tag name="param">owner: 回调拥有者。</tag>
				<tag name="return">取消数量。</tag>
				<tag name="since">7.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="clear">
			<signature>func clear() -&gt; void:</signature>
			<description>清空全部待派发回调和统计。</description>
