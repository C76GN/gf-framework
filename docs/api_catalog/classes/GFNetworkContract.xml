<class name="GFNetworkContract" path="addons/gf/extensions/network/contracts/gf_network_contract.gd" module="extensions/network" extends="Resource" classDigest="80b36c210e725b00afe8bddcbb1a50a2a80d6c0d7ac4508cfa319bae8afa1579">
	<description>GFNetworkContract: 网络消息契约集合。
契约集合用于集中描述一组 GFNetworkMessage 的 message_type、字段和默认通道，
方便项目生成强类型辅助代码或在运行前校验消息结构。</description>
	<tags>
		<tag name="api">public</tag>
		<tag name="category">resource_definition</tag>
		<tag name="since">3.17.0</tag>
	</tags>
	<signals />
	<enums />
	<constants />
	<properties>
		<member kind="property" name="contract_id" decorators="@export">
			<signature>var contract_id: StringName = &amp;""</signature>
			<description>契约稳定标识。</description>
			<tags>
				<tag name="api">public</tag>
			</tags>
		</member>
		<member kind="property" name="display_name" decorators="@export">
			<signature>var display_name: String = ""</signature>
			<description>编辑器展示名称。</description>
			<tags>
				<tag name="api">public</tag>
			</tags>
		</member>
		<member kind="property" name="contract_version_major" decorators="@export">
			<signature>var contract_version_major: int = 0</signature>
			<description>契约兼容大版本。项目可在不兼容的消息结构变化时显式递增。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
		<member kind="property" name="contract_version_minor" decorators="@export">
			<signature>var contract_version_minor: int = 0</signature>
			<description>契约兼容小版本。小版本只用于日志、排查或构建追踪，不参与默认兼容判断。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
		<member kind="property" name="messages" decorators="@export">
			<signature>var messages: Array[GFNetworkContractMessage] = []</signature>
			<description>消息契约列表。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="schema">messages: Array[GFNetworkContractMessage]，按声明顺序保存消息契约。</tag>
			</tags>
		</member>
		<member kind="property" name="metadata" decorators="@export">
			<signature>var metadata: Dictionary = {}</signature>
			<description>项目自定义元数据。框架不解释该字段。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="schema">metadata: Dictionary，保存项目自定义契约元数据。</tag>
			</tags>
		</member>
	</properties>
	<methods>
		<member kind="method" name="get_display_name">
			<signature>func get_display_name() -&gt; String:</signature>
			<description>获取展示名称。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">展示名称。</tag>
			</tags>
		</member>
		<member kind="method" name="set_message_contract">
			<signature>func set_message_contract(message_contract: GFNetworkContractMessage) -&gt; void:</signature>
			<description>设置或替换一个消息契约。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">message_contract: 消息契约。</tag>
			</tags>
		</member>
		<member kind="method" name="get_message_contract">
			<signature>func get_message_contract(message_type: StringName) -&gt; GFNetworkContractMessage:</signature>
			<description>获取消息契约。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">message_type: 消息类型。</tag>
				<tag name="return">消息契约；不存在时返回 null。</tag>
			</tags>
		</member>
		<member kind="method" name="has_message_contract">
			<signature>func has_message_contract(message_type: StringName) -&gt; bool:</signature>
			<description>检查消息契约是否存在。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">message_type: 消息类型。</tag>
				<tag name="return">存在返回 true。</tag>
			</tags>
		</member>
		<member kind="method" name="make_message">
			<signature>func make_message(message_type: StringName, values: Dictionary = {}, options: Dictionary = {}) -&gt; GFNetworkMessage:</signature>
			<description>按消息契约创建 GFNetworkMessage。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">message_type: 消息类型。</tag>
				<tag name="param">values: 字段值字典。</tag>
				<tag name="param">options: 可选元信息。</tag>
				<tag name="return">网络消息；契约不存在时返回 null。</tag>
				<tag name="schema">values: Dictionary[StringName|String, Variant]，字段名到字段值的映射。</tag>
				<tag name="schema">options: Dictionary，支持 include_defaults、sequence、tick、sender_id、channel_id。</tag>
			</tags>
		</member>
		<member kind="method" name="validate_message">
			<signature>func validate_message(message: GFNetworkMessage) -&gt; Dictionary:</signature>
			<description>校验网络消息是否匹配本契约集合。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">message: 网络消息。</tag>
				<tag name="return">校验报告字典。</tag>
				<tag name="schema">return: Dictionary，GFValidationReportDictionary 格式，包含 ok、issues、issue_count 和 next_actions。</tag>
			</tags>
		</member>
		<member kind="method" name="validate_contract">
			<signature>func validate_contract() -&gt; Dictionary:</signature>
			<description>校验契约定义是否完整。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">校验报告字典。</tag>
				<tag name="schema">return: Dictionary，GFValidationReportDictionary 格式，包含 ok、issues、issue_count 和 next_actions。</tag>
			</tags>
		</member>
		<member kind="method" name="describe">
			<signature>func describe() -&gt; Dictionary:</signature>
			<description>描述契约集合。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">描述字典。</tag>
				<tag name="schema">return: Dictionary，包含 contract_id、display_name、contract_version_major、contract_version_minor、schema_digest、message_count、messages、metadata。</tag>
				<tag name="since">3.17.0</tag>
			</tags>
		</member>
		<member kind="method" name="get_schema_descriptor">
			<signature>func get_schema_descriptor() -&gt; Dictionary:</signature>
			<description>导出只包含协议结构的稳定 schema 描述。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">schema 描述字典。</tag>
				<tag name="schema">return: Dictionary，包含 schema_version、contract_id 和 messages；不包含 display_name 或 metadata。</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="get_schema_digest">
			<signature>func get_schema_digest(options: Dictionary = {}) -&gt; String:</signature>
			<description>计算契约 schema 描述的稳定 SHA-256。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">options: 传给 GFDeterministicVariantSerializer.sha256() 的选项；默认允许有限浮点默认值参与摘要。</tag>
				<tag name="return">SHA-256 hex；schema 中存在不支持的 Variant 时返回空字符串。</tag>
				<tag name="schema">options: Dictionary，支持 allow_floats 和 max_depth。</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="get_contract_version">
			<signature>func get_contract_version() -&gt; Dictionary:</signature>
			<description>获取可通过网络、日志或预检报告传递的契约版本字典。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">契约版本字典。</tag>
				<tag name="schema">return: Dictionary，包含 contract_id、version_major、version_minor、schema_descriptor_version 和 schema_digest。</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="validate_peer_contract_version">
			<signature>func validate_peer_contract_version(peer_version: Dictionary, options: Dictionary = {}) -&gt; Dictionary:</signature>
			<description>校验对端声明的契约版本。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">peer_version: 对端通过 get_contract_version() 或等价结构上报的版本字典。</tag>
				<tag name="param">options: 校验选项，支持 require_contract_id、require_schema_digest 和 severity。</tag>
				<tag name="return">GFValidationReportDictionary 兼容报告。</tag>
				<tag name="schema">peer_version: Dictionary，包含 contract_id、version_major、version_minor 和 schema_digest。</tag>
				<tag name="schema">options: Dictionary，require_contract_id 默认 true，require_schema_digest 默认 false，severity 默认为 error。</tag>
				<tag name="schema">return: Dictionary，包含 ok、local_version、peer_version、issues、issue_count 和 next_actions。</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
	</methods>
