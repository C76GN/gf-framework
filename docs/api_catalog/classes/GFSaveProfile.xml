			<description>拒绝当前 Profile 未声明的 section。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="since">10.0.0</tag>
			</tags>
		</member>
		<member kind="const" name="UNKNOWN_SECTION_PRESERVE">
			<signature>const UNKNOWN_SECTION_PRESERVE: StringName = &amp;"preserve"</signature>
			<description>读取时接受未知 section，并在后续保存中原样保留。</description>
