<class name="GFObservableDictionaryResource" path="addons/gf/standard/foundation/collections/gf_observable_dictionary_resource.gd" module="standard" extends="Resource" classDigest="e6e61e94cb4301cb28de1183ba4df4a60065a31f259c0314eef1233ee7c2dea4">
	<description>GFObservableDictionaryResource: 可观察字典资源。
保存一份 Dictionary 数据，并通过显式方法发出键值变更和批量变更信号。
它不尝试模拟 Dictionary 的全部接口，避免把业务状态模型写死到框架层。</description>
	<tags>
		<tag name="api">public</tag>
		<tag name="category">resource_definition</tag>
		<tag name="since">6.0.0</tag>
	</tags>
	<signals>
		<member kind="signal" name="entry_changed">
			<signature>signal entry_changed(operation: StringName, entry_key: Variant, old_value: Variant, new_value: Variant, metadata: Dictionary)</signature>
			<description>非 batch 模式下单个键值变更后发出。batch 内变更只在 end_batch() 时汇总到 entries_changed。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">operation: 操作类型。</tag>
				<tag name="param">entry_key: 变更键。</tag>
				<tag name="param">old_value: 旧值。</tag>
				<tag name="param">new_value: 新值。</tag>
				<tag name="param">metadata: 调用方元数据。</tag>
				<tag name="schema">entry_key: Variant dictionary key.</tag>
				<tag name="schema">old_value: Variant copied from the dictionary before mutation.</tag>
				<tag name="schema">new_value: Variant copied into the dictionary after mutation.</tag>
				<tag name="schema">metadata: Dictionary copied from the mutation call.</tag>
				<tag name="since">6.0.0</tag>
			</tags>
		</member>
		<member kind="signal" name="entries_changed">
			<signature>signal entries_changed(changes: Array[Dictionary], metadata: Dictionary)</signature>
			<description>一批键值变更完成后发出；非 batch 单项变更也会作为单元素 changes 发出。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">changes: 变更报告列表。</tag>
				<tag name="param">metadata: 批量元数据。</tag>
				<tag name="schema">changes: Array[Dictionary] mutation reports.</tag>
				<tag name="schema">metadata: Dictionary copied from begin_batch()/end_batch().</tag>
				<tag name="since">6.0.0</tag>
			</tags>
		</member>
	</signals>
