		<member kind="enum" name="Kind">
			<signature>enum Kind {
	## 未配置 intent。
	NONE = 0,
	## 请求按 world-space 速度移动。
	MOVE = 1,
	## 策略拒绝产生可应用 intent。
	REJECTED = 2,
	## 策略正常请求结束当前 session。
	FINISH = 3,
}</signature>
			<description>定义 motion 计算的封闭输出种类。</description>
