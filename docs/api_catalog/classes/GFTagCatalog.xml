			<signature>func validate_tag_source(source: Variant, options: Dictionary = {}) -&gt; GFValidationReport:</signature>
			<description>校验标签源是否满足目录声明。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">source: 标签源。</tag>
				<tag name="param">options: 校验选项，支持 subject、allow_undefined_tags 和 max_redirect_depth。</tag>
				<tag name="return">校验报告。</tag>
				<tag name="schema">source: Variant accepted by GFTagSourceAdapter.</tag>
				<tag name="schema">options: Dictionary validation options.</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="validate_definition">
			<signature>func validate_definition(options: Dictionary = {}) -&gt; GFValidationReport:</signature>
			<description>校验目录定义自身。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">options: 校验选项，支持 subject。</tag>
				<tag name="return">校验报告。</tag>
				<tag name="schema">options: Dictionary validation options.</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
