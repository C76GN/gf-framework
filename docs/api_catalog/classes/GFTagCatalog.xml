			<signature>func duplicate_catalog() -&gt; GFTagCatalog:</signature>
			<description>创建同内容拷贝。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">新标签目录。</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
