			<signature>func to_dictionary() -&gt; Dictionary:</signature>
			<description>导出为字典。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">标签目录字典。</tag>
				<tag name="schema">return: Dictionary serialized tag catalog.</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
