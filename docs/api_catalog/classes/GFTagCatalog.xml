			<signature>static func from_dictionary(data: Dictionary) -&gt; GFTagCatalog:</signature>
			<description>从字典创建标签目录。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">data: 标签目录字典。</tag>
				<tag name="return">新标签目录。</tag>
				<tag name="schema">data: Dictionary serialized tag catalog.</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
