				<tag name="api">public</tag>
				<tag name="param">slot_index: 槽位索引。</tag>
				<tag name="return">元数据文件名。</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="save_slot">
			<signature>func save_slot( slot_index: int, document: GFSaveDocument, metadata: Dictionary = {} ) -&gt; Error:</signature>
			<description>保存版本化槽位文档和元数据。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">slot_index: 槽位索引；必须大于等于 0。</tag>
				<tag name="param">document: 项目聚合后的版本化存档文档。</tag>
				<tag name="param">metadata: 槽位摘要元数据。</tag>
				<tag name="return">Godot 的 `Error` 结果码。</tag>
				<tag name="schema">metadata: Dictionary，通常来自 GFSaveSlotMetadata.to_dict()。</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="load_slot">
			<signature>func load_slot( slot_index: int, target_schema: GFSaveDocumentSchema = null, migrations: GFSaveMigrationRegistry = null, context: Dictionary = {} ) -&gt; GFSaveDocumentReadResult:</signature>
			<description>读取、迁移并校验槽位文档。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">slot_index: 槽位索引。</tag>
				<tag name="param">target_schema: 可选目标 schema；提供后要求最终版本完全匹配。</tag>
				<tag name="param">migrations: 可选迁移注册表；旧版本文档需要迁移时必须提供。</tag>
				<tag name="param">context: 项目定义的迁移上下文。</tag>
				<tag name="return">强类型读取结果。</tag>
				<tag name="schema">context: Dictionary with caller-defined ephemeral migration data.</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="load_slot_metadata">
			<signature>func load_slot_metadata(slot_index: int) -&gt; Dictionary:</signature>
			<description>读取槽位元数据。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">slot_index: 槽位索引。</tag>
				<tag name="return">槽位元数据；读取失败时为空字典。</tag>
				<tag name="schema">return: Dictionary，通常兼容 GFSaveSlotMetadata.to_dict()。</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="has_slot">
			<signature>func has_slot(slot_index: int) -&gt; bool:</signature>
			<description>检查槽位是否同时具备数据和元数据文件。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">slot_index: 槽位索引。</tag>
				<tag name="return">同时存在数据和元数据时返回 true。</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="delete_slot">
			<signature>func delete_slot(slot_index: int) -&gt; Error:</signature>
			<description>删除槽位数据和元数据文件。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">slot_index: 槽位索引。</tag>
				<tag name="return">两个文件都成功删除时返回 OK；任一文件缺失时返回 ERR_FILE_NOT_FOUND。</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="list_slots">
			<signature>func list_slots() -&gt; Array[Dictionary]:</signature>
			<description>枚举现有槽位摘要。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">槽位摘要数组。</tag>
				<tag name="schema">return: Array[Dictionary]，每项包含 slot_index、slot_id、metadata 和 modified_time。</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
