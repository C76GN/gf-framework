			<signature>func get_data_file_name(slot_index: int) -&gt; String:</signature>
			<description>生成槽位数据文件名。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">slot_index: 槽位索引。</tag>
				<tag name="return">数据文件名。</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
