		<member kind="method" name="setup">
			<signature>func setup(storage: GFStorageUtility, clock: GFClock = null) -&gt; GFSaveSlotStorageAdapter:</signature>
			<description>设置底层存储工具。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">storage: 底层 GFStorageUtility。</tag>
				<tag name="param">clock: 可选墙上时钟；为空时保留当前时钟。</tag>
				<tag name="return">当前适配器。</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="get_storage">
			<signature>func get_storage() -&gt; GFStorageUtility:</signature>
			<description>获取底层存储工具。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">当前 GFStorageUtility；未配置时返回 null。</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="set_clock">
			<signature>func set_clock(clock: GFClock) -&gt; bool:</signature>
			<description>设置缺省元数据时间戳使用的墙上时钟。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">clock: 新时钟。</tag>
				<tag name="return">时钟合法并完成设置时返回 true。</tag>
				<tag name="since">9.0.0</tag>
			</tags>
		</member>
