			<signature>const DEFAULT_DATA_FILE_TEMPLATE: String = "slot_{index}_data.sav"</signature>
			<description>默认槽位数据文件模板。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
		<member kind="const" name="DEFAULT_METADATA_FILE_TEMPLATE">
			<signature>const DEFAULT_METADATA_FILE_TEMPLATE: String = "slot_{index}_meta.sav"</signature>
			<description>默认槽位元数据文件模板。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
	</constants>
