			<tags>
				<tag name="api">public</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
		<member kind="property" name="metadata_file_template" decorators="@export">
			<signature>var metadata_file_template: String = DEFAULT_METADATA_FILE_TEMPLATE</signature>
			<description>元数据文件模板，支持 `{index}` 占位符。</description>
