			<signature>func get_clock() -&gt; GFClock:</signature>
			<description>获取缺省元数据时间戳使用的时钟。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">当前时钟。</tag>
				<tag name="since">9.0.0</tag>
			</tags>
		</member>
