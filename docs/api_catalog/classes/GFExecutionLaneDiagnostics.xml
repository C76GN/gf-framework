			<tags>
				<tag name="api">public</tag>
				<tag name="param">lane_id: 执行通道 ID。</tag>
				<tag name="param">event: 事件快照副本。</tag>
				<tag name="schema">event: Dictionary，包含 event_type、lane_id、status、计数和 metadata。</tag>
				<tag name="since">7.0.0</tag>
			</tags>
		</member>
	</signals>
