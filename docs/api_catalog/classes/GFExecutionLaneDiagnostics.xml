<class name="GFExecutionLaneDiagnostics" path="addons/gf/standard/common/gf_execution_lane_diagnostics.gd" module="standard" extends="RefCounted" classDigest="0327052c4b372278d1ff59d9900d60e31bcf507279dca3cc0329d6f95313a563">
	<description>GFExecutionLaneDiagnostics: 通用执行通道诊断快照。
用于记录按 lane 划分的 queued / active / completed / failed / timeout / cancelled
等运行态指标。它只保存诊断数据，不调度任务、不决定重试策略，也不绑定具体业务通道。</description>
	<tags>
		<tag name="api">public</tag>
		<tag name="category">runtime_service</tag>
		<tag name="since">7.0.0</tag>
	</tags>
	<signals>
		<member kind="signal" name="lane_snapshot_recorded">
			<signature>signal lane_snapshot_recorded(lane_id: StringName, snapshot: Dictionary)</signature>
			<description>lane 快照记录或更新时发出。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">lane_id: 执行通道 ID。</tag>
				<tag name="param">snapshot: lane 快照副本。</tag>
				<tag name="schema">snapshot: Dictionary，包含 queued_count、active_count、completed_count、failed_count、timeout_count、cancelled_count 和 metadata。</tag>
				<tag name="since">7.0.0</tag>
			</tags>
		</member>
