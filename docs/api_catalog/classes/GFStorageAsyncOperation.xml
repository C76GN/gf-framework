<class name="GFStorageAsyncOperation" path="addons/gf/standard/utilities/storage/gf_storage_async_operation.gd" module="standard" extends="RefCounted" classDigest="a67623656088095c9ae70e244a4c3ed2ee0fe6df0f4520f1527ee60a5bf8f23e">
	<description>GFStorageAsyncOperation: 单次异步存储请求句柄。
句柄由 `GFStorageUtility` 分配唯一请求 ID，并且只接受一个终态。调用方应先
检查 `is_completed()`，再决定是否等待 `completed` 信号。</description>
	<tags>
		<tag name="api">public</tag>
		<tag name="category">runtime_handle</tag>
		<tag name="since">10.0.0</tag>
	</tags>
	<signals>
		<member kind="signal" name="completed">
			<signature>signal completed(result: GFStorageAsyncResult)</signature>
			<description>请求进入终态时发出一次。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">result: 与当前请求 ID 匹配的隔离结果。</tag>
				<tag name="since">10.0.0</tag>
			</tags>
		</member>
	</signals>
