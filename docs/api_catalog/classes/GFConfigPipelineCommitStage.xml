				<tag name="api">public</tag>
				<tag name="return">阶段描述。</tag>
				<tag name="schema">return: Dictionary，包含 stage_id、implementation_version、input_contract 和 output_contract。</tag>
				<tag name="since">unreleased</tag>
			</tags>
		</member>
