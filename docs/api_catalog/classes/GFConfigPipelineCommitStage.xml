		<member kind="const" name="STAGE_ID">
			<signature>const STAGE_ID: String = "gf.config.commit.filesystem"</signature>
			<description>Commit 阶段的稳定实现标识。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="since">unreleased</tag>
			</tags>
		</member>
		<member kind="const" name="IMPLEMENTATION_VERSION">
			<signature>const IMPLEMENTATION_VERSION: int = 1</signature>
			<description>Commit 阶段的实现版本；改变事务或回滚语义时递增。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="since">unreleased</tag>
			</tags>
		</member>
	</constants>
	<properties />
	<methods>
		<member kind="method" name="begin">
			<signature>func begin(paths: PackedStringArray) -&gt; Dictionary:</signature>
			<description>捕获待写入路径的事务前状态。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">paths: 本次事务可能创建或覆盖的完整路径集合。</tag>
				<tag name="return">提交事务。</tag>
				<tag name="schema">return: Dictionary，包含 success、format、format_version、state、entries、error_kind 和 error。</tag>
				<tag name="since">unreleased</tag>
			</tags>
		</member>
		<member kind="method" name="rollback">
			<signature>func rollback(transaction: Dictionary) -&gt; Dictionary:</signature>
			<description>逆序恢复事务前状态；已存在文件恢复快照，事务中新建文件被删除。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">transaction: begin() 返回且仍处于 open 状态的事务。</tag>
				<tag name="return">回滚结果。</tag>
				<tag name="schema">transaction: Dictionary，符合 gf.config_pipeline.commit_transaction@1。</tag>
				<tag name="schema">return: Dictionary，包含 success、phase、restored_paths、failed_paths、issues、error_kind 和 error。</tag>
				<tag name="since">unreleased</tag>
			</tags>
		</member>
		<member kind="method" name="complete">
			<signature>func complete(transaction: Dictionary) -&gt; Dictionary:</signature>
			<description>完成事务并删除全部回滚快照。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">transaction: begin() 返回且仍处于 open 状态的事务。</tag>
				<tag name="return">提交完成结果。</tag>
				<tag name="schema">transaction: Dictionary，符合 gf.config_pipeline.commit_transaction@1。</tag>
				<tag name="schema">return: Dictionary，包含 success、phase、restored_paths、failed_paths、issues、error_kind 和 error。</tag>
				<tag name="since">unreleased</tag>
			</tags>
		</member>
		<member kind="method" name="get_stage_descriptor">
			<signature>func get_stage_descriptor() -&gt; Dictionary:</signature>
			<description>返回阶段实现的稳定描述，用于流水线诊断和编译指纹。</description>
