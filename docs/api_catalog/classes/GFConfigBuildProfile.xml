		<member kind="method" name="filter_records">
			<signature>func filter_records(table_data: Variant) -&gt; Variant:</signature>
			<description>过滤表记录。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">table_data: Array[Dictionary] 或 Dictionary 表。</tag>
