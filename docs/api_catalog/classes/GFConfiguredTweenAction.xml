			<signature>func get_wait_guard_node() -&gt; Node:</signature>
			<description>获取保护等待生命周期的宿主节点。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">有效宿主，无效时返回 null。</tag>
				<tag name="since">3.6.0</tag>
			</tags>
		</member>
