				<tag name="api">public</tag>
			</tags>
		</member>
	</properties>
	<methods>
		<member kind="method" name="serialize_value">
			<signature>func serialize_value(value: Variant) -&gt; Variant:</signature>
			<description>编码字段值。Quaternion 固定输出归一化的 [x, y, z, w]；非法旋转回退为单位四元数。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">value: 原始值。</tag>
				<tag name="return">可序列化值。</tag>
				<tag name="schema">value: Variant，原始字段值。</tag>
				<tag name="schema">return: Variant，可序列化字段值；向量、颜色和 Quaternion 会编码为 Array。</tag>
				<tag name="since">3.17.0</tag>
			</tags>
		</member>
		<member kind="method" name="deserialize_value">
			<signature>func deserialize_value(value: Variant) -&gt; Variant:</signature>
			<description>解码字段值。Quaternion 数组会恢复单位长度，零长度或非有限分量回退为单位四元数。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">value: 编码值。</tag>
				<tag name="return">解码后的值。</tag>
				<tag name="schema">value: Variant，serialize_value() 产生的编码值或兼容输入。</tag>
				<tag name="schema">return: Variant，按 value_type 解码后的字段值。</tag>
				<tag name="since">3.17.0</tag>
			</tags>
		</member>
		<member kind="method" name="duplicate_serializer">
			<signature>func duplicate_serializer() -&gt; GFNetworkFieldSerializer:</signature>
			<description>复制编码器配置。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">新编码器。</tag>
			</tags>
		</member>
	</methods>
