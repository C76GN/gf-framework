			<signature>var value_type: ValueType = ValueType.VARIANT</signature>
			<description>字段值类型。</description>
			<tags>
				<tag name="api">public</tag>
			</tags>
		</member>
		<member kind="property" name="quantize_decimals" decorators="@export_range(-1, 8, 1)">
			<signature>var quantize_decimals: int = -1</signature>
			<description>浮点量化小数位；小于 0 表示不量化。</description>
			<tags>
				<tag name="api">public</tag>
			</tags>
		</member>
		<member kind="property" name="clamp_enabled" decorators="@export">
			<signature>var clamp_enabled: bool = false</signature>
			<description>是否夹取数值。</description>
			<tags>
				<tag name="api">public</tag>
			</tags>
		</member>
		<member kind="property" name="min_value" decorators="@export">
			<signature>var min_value: float = 0.0</signature>
			<description>数值夹取下限。</description>
			<tags>
				<tag name="api">public</tag>
			</tags>
		</member>
		<member kind="property" name="max_value" decorators="@export">
			<signature>var max_value: float = 1.0</signature>
