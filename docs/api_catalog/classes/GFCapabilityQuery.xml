			<tags>
				<tag name="api">public</tag>
				<tag name="return">查询声明字典。</tag>
				<tag name="schema">return: Dictionary，包含 required_capability_types、rejected_capability_types、include_subclasses、group_name 和 metadata。</tag>
				<tag name="since">6.0.0</tag>
			</tags>
		</member>
	</methods>
