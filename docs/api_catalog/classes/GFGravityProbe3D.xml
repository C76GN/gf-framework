<class name="GFGravityProbe3D" path="addons/gf/extensions/physics/nodes/gf_gravity_probe_3d.gd" module="extensions/physics" extends="Node3D" classDigest="e973c7ff4b32923d5f82fbba0e0360e1912b0d7d56a47660d685f64ca172769a">
	<description>GFGravityProbe3D: 通用 3D 重力采样器。
从场景树分组中采样 GFGravityField3D 或任何暴露 get_acceleration_at()
方法的对象，并按组合策略计算当前位置处的加速度、上下方向。</description>
	<tags>
		<tag name="api">public</tag>
		<tag name="category">runtime_handle</tag>
		<tag name="since">3.17.0</tag>
	</tags>
	<signals />
	<enums>
		<member kind="enum" name="CombinationMode">
			<signature>enum CombinationMode {
	## 汇总所有有效力场的加速度。
	SUM,
	## 只使用当前点加速度长度最大的力场。
	STRONGEST,
	## 只汇总当前点非零加速度中最高优先级的力场。
	HIGHEST_PRIORITY,
}</signature>
			<description>多个力场重叠时的采样组合策略。</description>
			<tags>
				<tag name="api">public</tag>
			</tags>
		</member>
	</enums>
	<constants />
	<properties>
		<member kind="property" name="field_group" decorators="@export">
			<signature>var field_group: StringName = &amp;"gf_gravity_field_3d"</signature>
			<description>要采样的力场分组。</description>
			<tags>
				<tag name="api">public</tag>
			</tags>
		</member>
		<member kind="property" name="combination_mode" decorators="@export">
			<signature>var combination_mode: CombinationMode = CombinationMode.SUM</signature>
			<description>多个力场重叠时的组合策略。</description>
			<tags>
				<tag name="api">public</tag>
			</tags>
		</member>
		<member kind="property" name="use_fallback_when_empty" decorators="@export">
			<signature>var use_fallback_when_empty: bool = true</signature>
			<description>找不到力场时是否返回 fallback_acceleration。</description>
			<tags>
				<tag name="api">public</tag>
			</tags>
		</member>
		<member kind="property" name="fallback_acceleration" decorators="@export">
			<signature>var fallback_acceleration: Vector3 = Vector3.DOWN * 9.8</signature>
			<description>找不到力场时使用的默认加速度。</description>
			<tags>
				<tag name="api">public</tag>
			</tags>
		</member>
		<member kind="property" name="cache_samples_per_frame" decorators="@export">
			<signature>var cache_samples_per_frame: bool = true</signature>
			<description>同一帧、同一位置重复 sample() 时是否复用上次结果。</description>
			<tags>
				<tag name="api">public</tag>
			</tags>
		</member>
		<member kind="property" name="last_acceleration">
			<signature>var last_acceleration: Vector3 = Vector3.ZERO</signature>
			<description>最近一次 sample() 得到的加速度。</description>
			<tags>
				<tag name="api">public</tag>
			</tags>
		</member>
	</properties>
