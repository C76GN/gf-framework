	<enums>
		<member kind="enum" name="Status">
			<signature>enum Status {
	## 等待完成。
	PENDING,
	## 已成功完成。
	SUCCEEDED,
	## 已失败。
	FAILED,
	## 已取消。
	CANCELLED,
	## 当前调用线程无权读取状态。
	INVALID,
}</signature>
