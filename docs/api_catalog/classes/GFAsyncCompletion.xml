	<enums>
		<member kind="enum" name="Status">
			<signature>enum Status {
	## 等待完成。
	PENDING,
	## 已成功完成。
	SUCCEEDED,
	## 已失败。
	FAILED,
	## 已取消。
	CANCELLED,
}</signature>
			<description>完成源状态。</description>
			<tags>
				<tag name="api">public</tag>
