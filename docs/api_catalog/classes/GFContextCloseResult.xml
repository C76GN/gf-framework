			<signature>func is_closed() -&gt; bool:</signature>
			<description>检查本次尝试结束后上下文是否已关闭。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">已关闭时返回 true；ERR_BUSY 等拒绝可能仍未关闭。</tag>
				<tag name="since">unreleased</tag>
			</tags>
		</member>
		<member kind="method" name="is_drained">
			<signature>func is_drained() -&gt; bool:</signature>
			<description>检查全部拥有的工作是否正常完成静默关闭。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">无强制释放、取消、超时或失败时返回 true。</tag>
				<tag name="since">unreleased</tag>
			</tags>
		</member>
		<member kind="method" name="get_error_code">
			<signature>func get_error_code() -&gt; Error:</signature>
