				<tag name="param">scope_id: 清理作用域 ID。</tag>
				<tag name="param">cleanup_id: 清理项 ID。</tag>
				<tag name="return">成功移除返回 true。</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
