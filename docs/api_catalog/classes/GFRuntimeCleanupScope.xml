			<tags>
				<tag name="api">public</tag>
				<tag name="param">scope_id: 清理作用域 ID。</tag>
				<tag name="param">cleanup_id: 清理项 ID，同一 scope 内唯一。</tag>
				<tag name="param">callback: 无参数清理回调。</tag>
				<tag name="param">priority: 执行优先级，数值越大越先执行。</tag>
				<tag name="param">metadata: 调用方自定义元数据。</tag>
				<tag name="return">注册成功返回 true。</tag>
				<tag name="schema">metadata: Dictionary project-defined cleanup metadata copied into diagnostics.</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
