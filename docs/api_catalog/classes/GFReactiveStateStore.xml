			<signature>func clear_subscriptions(owner: Object = null) -&gt; void:</signature>
			<description>清理订阅。owner 为空时清理全部订阅。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">owner: 可选订阅 owner。</tag>
				<tag name="since">5.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="get_subscription_count">
			<signature>func get_subscription_count() -&gt; int:</signature>
			<description>获取有效订阅数量。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">有效订阅数量。</tag>
				<tag name="since">5.0.0</tag>
			</tags>
		</member>
