				<tag name="api">public</tag>
				<tag name="since">5.0.0</tag>
			</tags>
		</member>
		<member kind="const" name="SUBSCRIBE_ANY">
			<signature>const SUBSCRIBE_ANY: int = 2</signature>
			<description>接收所有路径变更。</description>
			<tags>
