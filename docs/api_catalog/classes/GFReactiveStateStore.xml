<?xml version="1.0" encoding="utf-8"?>
<class name="GFReactiveStateStore" path="addons/gf/standard/utilities/state/gf_reactive_state_store.gd" module="standard" extends="RefCounted" classDigest="6d6f8443296cc33bb53b74e5ba4273cbfde3f62d6df9ce17ec7f755230dac2bf">
	<description>GFReactiveStateStore: 运行时 Dictionary 状态树与路径订阅容器。
管理一份纯 Variant Dictionary 状态，提供路径读写、批量 dirty 派发、
路径订阅和 owner 生命周期清理。它不定义业务字段含义，也不替代
`GFBindableProperty` 的单值响应式协议。</description>
	<tags>
		<tag name="api">public</tag>
		<tag name="category">runtime_handle</tag>
		<tag name="since">5.0.0</tag>
	</tags>
	<signals>
		<member kind="signal" name="state_changed">
			<signature>signal state_changed(changes: Array[Dictionary], snapshot: Dictionary)</signature>
			<description>状态变更 flush 后发出。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">changes: 本次派发的变更记录。</tag>
				<tag name="param">snapshot: 当前状态快照。</tag>
				<tag name="schema">changes: Array[Dictionary]，每项包含 kind、path、path_segments、old_value、new_value、old_exists、new_exists、old_type、new_type。</tag>
				<tag name="schema">snapshot: Dictionary，当前状态深拷贝。</tag>
				<tag name="since">5.0.0</tag>
			</tags>
		</member>
		<member kind="signal" name="path_changed">
			<signature>signal path_changed(path: String, change: Dictionary)</signature>
			<description>单条路径变更派发时发出。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">path: 变更路径。</tag>
				<tag name="param">change: 变更记录。</tag>
				<tag name="schema">change: Dictionary，包含 kind、path、path_segments、old_value、new_value、old_exists、new_exists、old_type、new_type。</tag>
				<tag name="since">5.0.0</tag>
			</tags>
		</member>
	</signals>
