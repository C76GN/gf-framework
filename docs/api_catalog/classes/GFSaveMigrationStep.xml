			</tags>
		</member>
		<member kind="method" name="validate_step">
			<signature>func validate_step() -&gt; Dictionary:</signature>
			<description>校验步骤身份和版本边。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">结构化校验报告。</tag>
				<tag name="schema">return: GFValidationReportDictionary-compatible report with issues, counts, summary, and next_actions.</tag>
				<tag name="since">9.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="describe_step">
			<signature>func describe_step() -&gt; Dictionary:</signature>
			<description>描述步骤。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">步骤描述。</tag>
				<tag name="schema">return: Dictionary with step_id, schema_id, section_id, scope, from_version, and to_version.</tag>
