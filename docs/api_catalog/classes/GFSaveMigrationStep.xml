<?xml version="1.0" encoding="utf-8"?>
<class name="GFSaveMigrationStep" path="addons/gf/extensions/save/document/gf_save_migration_step.gd" module="extensions/save" extends="Resource" classDigest="d5108f98763292024955fdbbccab5350fb5037dd653d3d5f276760531da775ab">
	<description>GFSaveMigrationStep: 单向相邻版本迁移步骤协议。
空 section_id 表示文档级迁移；非空 section_id 表示单个分区迁移。
每个步骤只允许 `N -&gt; N + 1`，以消除路径歧义并保持迁移链可审计。</description>
	<tags>
		<tag name="api">public</tag>
		<tag name="category">protocol</tag>
		<tag name="since">9.0.0</tag>
	</tags>
	<signals />
	<enums />
	<constants />
	<properties>
		<member kind="property" name="step_id" decorators="@export">
			<signature>var step_id: StringName = &amp;""</signature>
			<description>稳定步骤 ID，用于诊断与审计。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="since">9.0.0</tag>
			</tags>
		</member>
		<member kind="property" name="schema_id" decorators="@export">
			<signature>var schema_id: StringName = &amp;""</signature>
			<description>步骤所属项目 schema ID。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="since">9.0.0</tag>
			</tags>
		</member>
		<member kind="property" name="section_id" decorators="@export">
			<signature>var section_id: StringName = &amp;""</signature>
			<description>目标分区 ID；为空表示文档级迁移。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="since">9.0.0</tag>
			</tags>
		</member>
		<member kind="property" name="from_version" decorators="@export">
			<signature>var from_version: int = 0</signature>
			<description>来源版本。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="since">9.0.0</tag>
			</tags>
		</member>
		<member kind="property" name="to_version" decorators="@export">
			<signature>var to_version: int = 0</signature>
			<description>目标版本，必须等于 from_version + 1。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="since">9.0.0</tag>
			</tags>
		</member>
	</properties>
