			<signature>signal async_handle_tracked(tracking_id: int, label: StringName)</signature>
			<description>句柄被登记时发出。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">tracking_id: 追踪 ID。</tag>
				<tag name="param">label: 追踪标签。</tag>
				<tag name="since">7.0.0</tag>
			</tags>
		</member>
		<member kind="signal" name="async_handle_untracked">
			<signature>signal async_handle_untracked(tracking_id: int, label: StringName)</signature>
			<description>句柄被移除追踪时发出。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">tracking_id: 追踪 ID。</tag>
				<tag name="param">label: 追踪标签。</tag>
				<tag name="since">7.0.0</tag>
			</tags>
		</member>
	</signals>
