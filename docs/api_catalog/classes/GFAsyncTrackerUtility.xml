		<member kind="method" name="track_handle">
			<signature>func track_handle( handle: Object, label: StringName = &amp;"", metadata: Dictionary = {}, snapshot_provider: Callable = Callable() ) -&gt; int:</signature>
			<description>登记一个异步句柄。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">handle: 待追踪对象。</tag>
				<tag name="param">label: 稳定标签；为空时使用 handle.get_class()。</tag>
				<tag name="param">metadata: 追踪上下文。</tag>
				<tag name="param">snapshot_provider: 可选无参快照回调；返回值会收窄为 Dictionary。</tag>
				<tag name="return">追踪 ID；未启用或 handle 为空时返回 0。</tag>
				<tag name="schema">metadata: Dictionary，包含调用方定义的追踪上下文。</tag>
				<tag name="since">7.0.0</tag>
			</tags>
		</member>
