<?xml version="1.0" encoding="utf-8"?>
<class name="GFConfigDatabaseResource" path="addons/gf/standard/utilities/config/gf_config_database_resource.gd" module="standard" extends="Resource" classDigest="32ae9d362fce35d3a02431c4d8bb83b0dbbfd886f00a420f0ab229c13e100ec7">
	<description>GFConfigDatabaseResource: 可保存为 Godot Resource 的通用配置数据库。
用于聚合多张 GFConfigTableResource，作为导表工具生成的整包配置产物。
该资源只承载通用表集合、校验入口和元数据，不绑定业务表语义、构建 profile 或热更新策略。</description>
	<tags>
		<tag name="api">public</tag>
		<tag name="category">resource_definition</tag>
		<tag name="since">5.2.0</tag>
	</tags>
	<signals />
	<enums />
	<constants />
	<properties>
		<member kind="property" name="database_id" decorators="@export">
			<signature>var database_id: StringName = &amp;""</signature>
			<description>配置数据库稳定标识。可用于区分主配置、测试配置或项目侧不同配置集合。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="since">5.2.0</tag>
			</tags>
		</member>
		<member kind="property" name="version" decorators="@export">
			<signature>var version: String = ""</signature>
			<description>可选配置版本。GF 不解释版本语义，只保存导表工具或项目层写入的字符串。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="since">5.2.0</tag>
			</tags>
		</member>
		<member kind="property" name="tables" decorators="@export">
			<signature>var tables: Array[GFConfigTableResource] = []</signature>
			<description>配置表资源列表。表名由每张 GFConfigTableResource.get_table_key() 决定。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="schema">tables: Array[GFConfigTableResource]，每个元素是一张配置表资源。</tag>
				<tag name="since">5.2.0</tag>
			</tags>
		</member>
		<member kind="property" name="metadata" decorators="@export">
			<signature>var metadata: Dictionary = {}</signature>
			<description>可选元数据，供导入器、编辑器或项目层扩展使用。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="schema">metadata: Dictionary，保存导表来源、构建摘要或项目侧附加信息。</tag>
				<tag name="since">5.2.0</tag>
			</tags>
		</member>
	</properties>
