			<signature>func clear_tables() -&gt; void:</signature>
			<description>清空所有配置表资源。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="since">5.2.0</tag>
			</tags>
		</member>
		<member kind="method" name="has_table">
			<signature>func has_table(table_name: StringName) -&gt; bool:</signature>
			<description>检查配置表是否存在。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">table_name: 表名。</tag>
				<tag name="return">存在返回 true。</tag>
				<tag name="since">5.2.0</tag>
			</tags>
		</member>
		<member kind="method" name="get_table_ids">
			<signature>func get_table_ids() -&gt; PackedStringArray:</signature>
			<description>获取配置表名列表。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">排序后的表名列表。</tag>
				<tag name="since">5.2.0</tag>
			</tags>
		</member>
		<member kind="method" name="get_tables_by_name">
			<signature>func get_tables_by_name(duplicate_records: bool = true) -&gt; Dictionary:</signature>
			<description>获取表名到表数据的字典。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">duplicate_records: 为 true 时返回记录深拷贝，避免调用方修改数据库资源内数据。</tag>
				<tag name="return">表名到表数据的字典。</tag>
				<tag name="schema">return: Dictionary，键为表名 StringName，值为 Array[Dictionary] 表数据。</tag>
				<tag name="since">5.2.0</tag>
			</tags>
		</member>
		<member kind="method" name="get_schemas">
			<signature>func get_schemas(duplicate_schemas: bool = true) -&gt; Array[GFConfigTableSchema]:</signature>
			<description>获取数据库中的 schema 列表。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">duplicate_schemas: 为 true 时返回 schema 深拷贝，避免调用方修改数据库资源内数据。</tag>
				<tag name="return">schema 列表。</tag>
				<tag name="schema">return: Array[GFConfigTableSchema]，每个元素是一张表的 schema。</tag>
				<tag name="since">5.2.0</tag>
			</tags>
		</member>
		<member kind="method" name="get_table_resources">
			<signature>func get_table_resources(duplicate_tables: bool = true) -&gt; Array[GFConfigTableResource]:</signature>
			<description>获取配置表资源列表。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">duplicate_tables: 为 true 时返回资源深拷贝，避免调用方修改数据库资源内数据。</tag>
				<tag name="return">表资源列表。</tag>
				<tag name="schema">return: Array[GFConfigTableResource]，每个元素是一张配置表资源。</tag>
				<tag name="since">5.2.0</tag>
			</tags>
		</member>
		<member kind="method" name="get_table_resource">
			<signature>func get_table_resource(table_name: StringName, duplicate_table: bool = true) -&gt; GFConfigTableResource:</signature>
			<description>获取配置表资源。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">table_name: 表名。</tag>
				<tag name="param">duplicate_table: 为 true 时返回资源深拷贝，避免调用方修改数据库资源内数据。</tag>
				<tag name="return">配置表资源；未命中时返回 null。</tag>
				<tag name="since">5.2.0</tag>
			</tags>
		</member>
		<member kind="method" name="validate_database">
			<signature>func validate_database(options: Dictionary = {}) -&gt; Dictionary:</signature>
			<description>校验数据库中的表结构、表数据和跨表引用。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">options: 可选上下文，支持 validate_schema，并透传给引用校验器。</tag>
				<tag name="return">聚合校验报告字典。</tag>
				<tag name="schema">options: Dictionary，可包含 validate_schema。</tag>
				<tag name="schema">return: GFConfigValidationReport 兼容 Dictionary。</tag>
				<tag name="since">5.2.0</tag>
			</tags>
		</member>
