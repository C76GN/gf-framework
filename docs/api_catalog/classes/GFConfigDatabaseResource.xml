			<signature>func rebuild_table_indexes() -&gt; int:</signature>
			<description>重建所有表资源的 ID 索引和命名索引缓存。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">成功处理的有效表数量。</tag>
				<tag name="since">5.2.0</tag>
			</tags>
		</member>
		<member kind="method" name="duplicate_database">
			<signature>func duplicate_database() -&gt; GFConfigDatabaseResource:</signature>
			<description>创建同内容拷贝，避免运行时修改污染共享 Resource。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">新配置数据库资源。</tag>
				<tag name="since">5.2.0</tag>
			</tags>
		</member>
	</methods>
