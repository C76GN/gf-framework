			<signature>func get_database_key() -&gt; StringName:</signature>
			<description>获取配置数据库稳定标识。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">配置数据库 ID；未声明时返回空 StringName。</tag>
				<tag name="since">5.2.0</tag>
			</tags>
		</member>
		<member kind="method" name="register_table">
			<signature>func register_table(table_resource: GFConfigTableResource) -&gt; bool:</signature>
			<description>注册一张配置表资源。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">table_resource: 要注册的配置表资源。</tag>
				<tag name="return">注册成功返回 true。</tag>
				<tag name="since">5.2.0</tag>
			</tags>
		</member>
		<member kind="method" name="register_tables">
			<signature>func register_tables(table_resources: Array[GFConfigTableResource]) -&gt; int:</signature>
			<description>批量注册配置表资源。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">table_resources: 要注册的配置表资源列表。</tag>
				<tag name="return">成功注册的数量。</tag>
				<tag name="schema">table_resources: Array[GFConfigTableResource]，每个元素是一张配置表资源。</tag>
				<tag name="since">5.2.0</tag>
			</tags>
		</member>
		<member kind="method" name="unregister_table">
			<signature>func unregister_table(table_name: StringName) -&gt; bool:</signature>
			<description>注销配置表资源。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">table_name: 表名。</tag>
				<tag name="return">找到并移除时返回 true。</tag>
				<tag name="since">5.2.0</tag>
			</tags>
		</member>
