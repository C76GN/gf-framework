			<signature>func get_remaining_cooldown_seconds(now_msec: int = -1) -&gt; float:</signature>
			<description>获取剩余冷却秒数。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">now_msec: 可选当前毫秒时间；小于 0 时使用 Time.get_ticks_msec()。</tag>
				<tag name="return">剩余冷却秒数。</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="is_configuration_valid">
			<signature>func is_configuration_valid() -&gt; bool:</signature>
			<description>检查策略数值配置是否有限。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">所有浮点配置有限时返回 true。</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="get_debug_snapshot">
			<signature>func get_debug_snapshot(now_msec: int = -1) -&gt; Dictionary:</signature>
			<description>获取策略调试快照。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">now_msec: 可选当前毫秒时间；小于 0 时使用 Time.get_ticks_msec()。</tag>
