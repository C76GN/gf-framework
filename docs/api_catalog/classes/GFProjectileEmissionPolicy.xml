	<methods>
		<member kind="method" name="prepare_emission">
			<signature>func prepare_emission( emitter: Node, projectile_id: StringName, projectile_context: Dictionary = {}, requested_count: int = 1, now_msec: int = -1 ) -&gt; Dictionary:</signature>
			<description>准备一次发射请求。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">emitter: 发射器节点。</tag>
				<tag name="param">projectile_id: 发射体目录 ID。</tag>
				<tag name="param">projectile_context: 调用方发射上下文。</tag>
				<tag name="param">requested_count: 本次请求准备生成的发射体数量。</tag>
				<tag name="param">now_msec: 可选当前毫秒时间；小于 0 时使用 Time.get_ticks_msec()。</tag>
				<tag name="return">发射准备报告。</tag>
				<tag name="schema">projectile_context: Dictionary，本次发射上下文；策略会复制后返回，不修改调用方原始字典。</tag>
				<tag name="schema">return: Dictionary，包含 ok、reason、policy_id、policy_instance_id、policy_state_generation、policy_enabled、projectile_id、requested_count、emit_count、projectile_context、now_msec、remaining_cooldown_seconds、available_charges 和 required_charges。</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="commit_emission">
			<signature>func commit_emission(emitter: Node, prepare_report: Dictionary, emitted_count: int) -&gt; Dictionary:</signature>
			<description>提交一次已生成的发射请求。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">emitter: 发射器节点。</tag>
				<tag name="param">prepare_report: prepare_emission() 返回的报告。</tag>
				<tag name="param">emitted_count: 实际成功生成的发射体数量。</tag>
				<tag name="return">提交报告。</tag>
				<tag name="schema">prepare_report: Dictionary，prepare_emission() 返回的报告；只允许签发策略在同一状态代际提交。</tag>
				<tag name="schema">return: Dictionary，包含 ok、committed、reason、emitted_count、emission_count、available_charges 和 consumed_charges。</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="reset">
			<signature>func reset(now_msec: int = -1) -&gt; void:</signature>
			<description>重置运行时策略状态。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">now_msec: 可选当前毫秒时间；小于 0 时使用 Time.get_ticks_msec()。</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="get_available_charges">
			<signature>func get_available_charges(now_msec: int = -1) -&gt; float:</signature>
			<description>获取当前可用 charge。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">now_msec: 可选当前毫秒时间；小于 0 时使用 Time.get_ticks_msec()。</tag>
				<tag name="return">当前可用 charge；未启用 charge 门控时返回 0。</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="get_required_charges">
			<signature>func get_required_charges(emit_count: int) -&gt; float:</signature>
			<description>获取指定生成数量需要消耗的 charge。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">emit_count: 预计生成数量。</tag>
				<tag name="return">需要消耗的 charge。</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
