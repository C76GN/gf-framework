	<methods>
		<member kind="method" name="register_table_source">
			<signature>func register_table_source(table_name: StringName, source: Variant, options: Dictionary = {}) -&gt; bool:</signature>
			<description>注册一个配置表源。
source 可以是 Array、Dictionary、自定义 Object 或 Callable。Callable 会在首次查询时以
`(table_name: StringName, metadata: Dictionary)` 调用，并返回实际表数据。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">table_name: 表名。</tag>
				<tag name="param">source: 表源。</tag>
				<tag name="param">options: 注册选项。</tag>
				<tag name="return">注册成功返回 true。</tag>
				<tag name="schema">source: Variant，支持 Array、Dictionary、Object 或 Callable；Object 可通过 table_method/record_method 适配。</tag>
				<tag name="schema">options: Dictionary，可包含 schema: GFConfigTableSchema、id_field: StringName/String、table_method: StringName/String、record_method: StringName/String、cache: bool、duplicate_values: bool 和 metadata: Dictionary。</tag>
				<tag name="since">7.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="unregister_table_source">
			<signature>func unregister_table_source(table_name: StringName) -&gt; bool:</signature>
			<description>注销一个配置表源。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">table_name: 表名。</tag>
				<tag name="return">找到并注销时返回 true。</tag>
				<tag name="since">7.0.0</tag>
			</tags>
		</member>
