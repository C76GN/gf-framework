<?xml version="1.0" encoding="utf-8"?>
<class name="GFJsonLineLogSink" path="addons/gf/standard/utilities/logging/gf_json_line_log_sink.gd" module="standard" extends="GFLogSink" classDigest="cc7623e89e639e3c6b5a54fa8dfd42ceb6df86205a74bec6e8a5bf20347615a8">
	<description>GFJsonLineLogSink: 把结构化日志条目写入 JSON Lines 文件。
该 sink 只负责把 GFLogUtility 传入的条目序列化为一行一个 JSON 对象，
不规定采集服务、上传时机或业务字段 schema。</description>
	<tags>
		<tag name="api">public</tag>
		<tag name="category">runtime_service</tag>
		<tag name="since">3.17.0</tag>
	</tags>
	<signals />
	<enums>
		<member kind="enum" name="FileOpenMode">
			<signature>enum FileOpenMode {
	## 每次 init() 截断已有文件。
	TRUNCATE,
	## 每次 init() 追加到已有文件末尾。
	APPEND,
	## 目标文件已存在时拒绝打开。
	FAIL_IF_EXISTS,
}</signature>
			<description>JSONL 文件打开策略。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
	</enums>
	<constants />
	<properties>
		<member kind="property" name="file_path" decorators="@export">
			<signature>var file_path: String = ""</signature>
			<description>输出文件路径。留空时会根据 GFLogUtility 当前日志文件派生同名 `.jsonl` 文件。</description>
			<tags>
				<tag name="api">public</tag>
			</tags>
		</member>
		<member kind="property" name="omit_formatted_text" decorators="@export">
			<signature>var omit_formatted_text: bool = false</signature>
			<description>是否在写入前移除 `text` 字段，减少重复存储。</description>
			<tags>
				<tag name="api">public</tag>
			</tags>
		</member>
		<member kind="property" name="flush_interval_msec" decorators="@export">
			<signature>var flush_interval_msec: int = 250</signature>
			<description>文件自动 flush 间隔。设为 0 时每条日志都会立即 flush。</description>
			<tags>
				<tag name="api">public</tag>
			</tags>
		</member>
		<member kind="property" name="flush_immediately" decorators="@export">
			<signature>var flush_immediately: bool = false</signature>
			<description>是否强制每条 JSONL 日志立即 flush。</description>
			<tags>
				<tag name="api">public</tag>
			</tags>
		</member>
		<member kind="property" name="max_jsonl_files" decorators="@export">
			<signature>var max_jsonl_files: int = 10:</signature>
			<description>使用默认派生路径时最多保留的 JSONL 文件数量。</description>
			<tags>
				<tag name="api">public</tag>
			</tags>
		</member>
		<member kind="property" name="file_open_mode" decorators="@export">
			<signature>var file_open_mode: FileOpenMode = FileOpenMode.TRUNCATE</signature>
			<description>自定义 file_path 重复初始化时的打开策略。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
	</properties>
	<methods>
		<member kind="method" name="get_report_redaction_profile">
			<signature>func get_report_redaction_profile() -&gt; String:</signature>
			<description>使用本地 JSONL 诊断所需的 debug 脱敏 profile。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">debug profile 名称。</tag>
				<tag name="schema">return: String naming GFReportValueCodec.REDACTION_PROFILE_DEBUG.</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="init">
			<signature>func init(owner: Object) -&gt; void:</signature>
			<description>初始化 sink 并打开 JSONL 文件。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">owner: 持有该 sink 的日志工具。</tag>
			</tags>
		</member>
		<member kind="method" name="write">
			<signature>func write(entry: Dictionary) -&gt; void:</signature>
			<description>写入一条结构化日志。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">entry: 日志条目字典。</tag>
				<tag name="schema">entry: Dictionary log entry produced by GFLogUtility.</tag>
			</tags>
		</member>
		<member kind="method" name="flush">
			<signature>func flush() -&gt; void:</signature>
			<description>刷新尚未写出的 JSONL 内容。</description>
			<tags>
				<tag name="api">public</tag>
			</tags>
		</member>
		<member kind="method" name="shutdown">
			<signature>func shutdown() -&gt; void:</signature>
			<description>关闭文件句柄。</description>
			<tags>
				<tag name="api">public</tag>
			</tags>
		</member>
		<member kind="method" name="get_file_path">
			<signature>func get_file_path() -&gt; String:</signature>
			<description>获取当前实际输出路径。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">JSONL 文件路径。</tag>
			</tags>
		</member>
		<member kind="method" name="get_debug_snapshot">
			<signature>func get_debug_snapshot() -&gt; Dictionary:</signature>
			<description>获取 JSONL sink 的调试快照。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">当前文件、打开状态和最近错误信息。</tag>
				<tag name="schema">return: Dictionary，包含 file_path、is_open、last_error、last_error_message、write_error_count、cleanup_error_count 和 uses_default_file_path。</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
	</methods>
	<innerClasses />
</class>
