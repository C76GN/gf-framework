			<signature>var allow_extra_fields: bool = true</signature>
			<description>是否允许包含 schema 未声明的字段。</description>
			<tags>
				<tag name="api">public</tag>
			</tags>
		</member>
		<member kind="property" name="coerce_values" decorators="@export">
			<signature>var coerce_values: bool = false</signature>
			<description>是否在校验前按字段声明尝试类型转换。</description>
			<tags>
				<tag name="api">public</tag>
			</tags>
		</member>
		<member kind="property" name="fail_on_coerce_error" decorators="@export">
			<signature>var fail_on_coerce_error: bool = true</signature>
