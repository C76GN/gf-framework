	<enums>
		<member kind="enum" name="Weekday">
			<signature>enum Weekday {
	## 星期一。
	MONDAY = 1,
	## 星期二。
	TUESDAY = 2,
	## 星期三。
	WEDNESDAY = 3,
	## 星期四。
	THURSDAY = 4,
	## 星期五。
	FRIDAY = 5,
	## 星期六。
	SATURDAY = 6,
	## 星期日。
	SUNDAY = 7,
}</signature>
			<description>ISO 8601 星期编号，星期一为 1，星期日为 7。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="since">11.0.0</tag>
			</tags>
		</member>
