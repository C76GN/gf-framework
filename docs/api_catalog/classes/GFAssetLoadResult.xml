		<member kind="enum" name="Status">
			<signature>enum Status {
	## 资源已成功交付到请求 scope；之后释放句柄不改变此终态。
	SUCCEEDED,
	## 请求未取得可交付句柄，具体原因由错误码表达。
	FAILED,
	## 请求已取消，不代表底层共享加载已经停止。
	CANCELLED,
}</signature>
