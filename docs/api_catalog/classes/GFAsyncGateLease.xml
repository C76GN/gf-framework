				<tag name="schema">return: Dictionary，调用方传入的 metadata 副本。</tag>
				<tag name="since">7.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="get_held_msec">
			<signature>func get_held_msec() -&gt; int:</signature>
			<description>获取租约持有时长。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">活跃租约返回当前持有毫秒数；已释放租约返回实际持有毫秒数。</tag>
				<tag name="since">7.0.0</tag>
			</tags>
		</member>
