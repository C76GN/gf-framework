			<signature>func get_key() -&gt; Variant:</signature>
			<description>获取租约 key 的副本。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">租约 key。</tag>
				<tag name="schema">return: Variant，调用方传入的 key 副本。</tag>
				<tag name="since">7.0.0</tag>
			</tags>
		</member>
