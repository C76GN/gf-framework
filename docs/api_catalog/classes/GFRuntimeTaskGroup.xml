<?xml version="1.0" encoding="utf-8"?>
<class name="GFRuntimeTaskGroup" path="addons/gf/standard/sequence/gf_runtime_task_group.gd" module="standard" extends="GFRuntimeTask" classDigest="0c80b1f0d84652fb4e7a5a4b728d61cb476f2493734161670e06afa34b1c600e">
	<description>组合多个运行时任务的复合任务。
任务组用于把多个 [GFRuntimeTask] 编排为顺序、等待全部或等待任一完成的流程。
子任务在组内部推进，不会单独注册到外层调度器；外层调度器只看到一个占用聚合后的任务。</description>
	<tags>
		<tag name="api">public</tag>
		<tag name="category">runtime_handle</tag>
		<tag name="since">6.0.0</tag>
	</tags>
	<signals />
	<enums>
		<member kind="enum" name="Mode">
			<signature>enum Mode {
	## 按顺序执行，每次只推进一个子任务。
	SEQUENCE,
	## 同时推进所有子任务，全部完成后任务组完成。
	PARALLEL_ALL,
	## 同时推进所有子任务，任一完成后任务组完成。
	PARALLEL_RACE,
}</signature>
			<description>子任务推进模式。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="category">config</tag>
				<tag name="since">6.0.0</tag>
			</tags>
		</member>
	</enums>
