<?xml version="1.0" encoding="utf-8"?>
<class name="GFInputPlayback" path="addons/gf/standard/input/recording/gf_input_playback.gd" module="standard" extends="RefCounted" classDigest="6d86101a507f99b05fcb7d76a8d7348fda2851ffafa8f7b55ab6daec849b7d54">
	<description>GFInputPlayback: 抽象输入录制回放器。
按时间把 GFInputRecording 中的动作值写入 GFVirtualInputSource，适合测试、
复现、教程或 AI 控制桥接。它只回放抽象动作，不模拟具体键鼠或手柄事件。</description>
	<tags>
		<tag name="api">public</tag>
		<tag name="category">runtime_service</tag>
		<tag name="since">3.17.0</tag>
	</tags>
