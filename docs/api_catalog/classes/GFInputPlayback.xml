		<member kind="signal" name="playback_started">
			<signature>signal playback_started(recording: GFInputRecording)</signature>
			<description>回放开始。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">recording: 回放录制。</tag>
			</tags>
		</member>
		<member kind="signal" name="playback_stopped">
			<signature>signal playback_stopped</signature>
			<description>回放停止。</description>
			<tags>
				<tag name="api">public</tag>
			</tags>
		</member>
		<member kind="signal" name="playback_finished">
			<signature>signal playback_finished</signature>
			<description>回放自然完成。</description>
			<tags>
				<tag name="api">public</tag>
			</tags>
		</member>
		<member kind="signal" name="event_applied">
			<signature>signal event_applied(event: Dictionary)</signature>
			<description>一个录制事件已被应用。事件索引会先提交再同步发出本信号；handler 可以调用
start/stop/reset/seek，旧 tick 会在 handler 返回后停止，不再推进新会话。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">event: 事件副本。</tag>
				<tag name="schema">event: Dictionary，包含 time_seconds、action_id、value、player_index、source_id 和 metadata。</tag>
				<tag name="since">11.0.0</tag>
			</tags>
		</member>
		<member kind="signal" name="loop_catch_up_limited">
			<signature>signal loop_catch_up_limited(deferred_seconds: float, skipped_cycles: int)</signature>
			<description>单帧循环追赶达到预算时发出。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">deferred_seconds: 留待后续 tick 无损处理的秒数。</tag>
				<tag name="param">skipped_cycles: 按策略显式跳过的完整周期数。</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
	</signals>
	<enums>
		<member kind="enum" name="LoopCatchUpPolicy">
			<signature>enum LoopCatchUpPolicy {
	## 保留剩余时间，在后续 tick 继续逐事件处理。
	DEFER_EXCESS,
	## 跳过超预算的完整周期，只重建最终周期状态。
	SKIP_EXCESS_CYCLES,
}</signature>
			<description>循环回放超出单帧周期预算时的处理策略。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
	</enums>
