			<signature>func is_completed() -&gt; bool:</signature>
			<description>检查请求是否已经完成。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">已有终态结果时返回 true。</tag>
				<tag name="since">9.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="is_successful">
			<signature>func is_successful() -&gt; bool:</signature>
			<description>检查请求是否成功。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">终态存在且成功时返回 true。</tag>
				<tag name="since">9.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="get_result">
			<signature>func get_result() -&gt; GFPlatformBridgeResult:</signature>
			<description>获取终态结果副本。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">终态结果副本；等待中返回 null。</tag>
				<tag name="since">9.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="cancel">
			<signature>func cancel(reason: StringName = &amp;"cancelled") -&gt; bool:</signature>
			<description>取消请求。
取消立即成为本地终态；adapter 会在 `completed` 前收到 `cancel_requested`，
但不能用迟到回调覆盖取消结果。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">reason: 取消原因。</tag>
				<tag name="return">首次取消成功返回 true。</tag>
				<tag name="since">9.0.0</tag>
			</tags>
		</member>
