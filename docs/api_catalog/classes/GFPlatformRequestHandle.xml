				<tag name="return">包含 request、pending、completed、successful 和 result 的字典。</tag>
				<tag name="schema">return: Dictionary with request, pending, completed, successful, and result fields.</tag>
				<tag name="since">9.0.0</tag>
			</tags>
		</member>
