			</tags>
		</member>
		<member kind="method" name="get_request_id">
			<signature>func get_request_id() -&gt; StringName:</signature>
			<description>获取请求 ID。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">请求 ID。</tag>
				<tag name="since">9.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="is_pending">
			<signature>func is_pending() -&gt; bool:</signature>
			<description>检查请求是否仍在等待终态。</description>
