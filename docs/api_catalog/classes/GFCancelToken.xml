<class name="GFCancelToken" path="addons/gf/standard/common/gf_cancel_token.gd" module="standard" extends="RefCounted" classDigest="10b4af2ac1c2c170dc271e23cb7156ef6ed8605f699c6960447763917dc79090">
	<description>GFCancelToken: 只读取消状态句柄。
取消 token 用于把“用户主动取消、生命周期结束、超时或上游取消”传递给异步流程。
调用方只能观察状态；实际取消由 [GFCancelSource] 负责触发。</description>
	<tags>
		<tag name="api">public</tag>
		<tag name="category">runtime_handle</tag>
		<tag name="since">7.0.0</tag>
	</tags>
	<signals>
		<member kind="signal" name="cancelled">
			<signature>signal cancelled(reason: StringName, metadata: Dictionary)</signature>
			<description>token 首次进入取消状态时发出。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">reason: 稳定取消原因。</tag>
				<tag name="param">metadata: 调用方附加的取消上下文。</tag>
				<tag name="schema">metadata: Dictionary，包含调用方定义的取消上下文。</tag>
				<tag name="since">7.0.0</tag>
			</tags>
		</member>
	</signals>
