			<signature>func is_cancelled() -&gt; bool:</signature>
			<description>判断 token 是否已经取消。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">已取消时返回 true。</tag>
				<tag name="since">7.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="get_reason">
			<signature>func get_reason() -&gt; StringName:</signature>
			<description>获取取消原因。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">取消原因；未取消时为空 StringName。</tag>
				<tag name="since">7.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="get_metadata">
			<signature>func get_metadata() -&gt; Dictionary:</signature>
			<description>获取取消元数据副本。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">取消元数据副本。</tag>
				<tag name="schema">return: Dictionary，包含调用方传入的取消上下文。</tag>
				<tag name="since">7.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="get_cancelled_msec">
			<signature>func get_cancelled_msec() -&gt; int:</signature>
			<description>获取取消发生时的 Time.get_ticks_msec()。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">取消发生时的毫秒 tick；未取消时为 0。</tag>
				<tag name="since">7.0.0</tag>
			</tags>
		</member>
