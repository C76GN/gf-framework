			<signature>var max_concurrent_loads: int = 0:</signature>
			<description>该计划默认最大并发加载数；0 表示不覆盖工具默认值。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
