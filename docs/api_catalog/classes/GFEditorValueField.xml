<?xml version="1.0" encoding="utf-8"?>
<class name="GFEditorValueField" path="addons/gf/kernel/editor/gf_editor_value_field.gd" module="kernel" extends="HBoxContainer" classDigest="4e1b6d7b88d819d4a569bf5ca65d1177c0ecb819574da4f004bc7c41e88782e1">
	<description>GFEditorValueField: 编辑器通用 Variant 值输入控件。
根据 Godot 属性信息创建基础输入控件，适合 Inspector、Dock 或批量资源表格复用。
支持调用方注册自定义控件工厂；自定义控件只需遵循 get_value、set_value、set_editable
和 value_changed 信号约定即可接入。</description>
	<tags>
		<tag name="api">public</tag>
		<tag name="category">editor_api</tag>
		<tag name="layer">kernel/editor</tag>
		<tag name="since">3.17.0</tag>
	</tags>
	<signals>
		<member kind="signal" name="value_changed">
			<signature>signal value_changed(value: Variant)</signature>
			<description>控件值变化时发出。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">value: 新值。</tag>
				<tag name="schema">value: Variant editor value read from the active control.</tag>
			</tags>
		</member>
		<member kind="signal" name="debounced_value_changed">
			<signature>signal debounced_value_changed(value: Variant)</signature>
			<description>控件值变化防抖后发出。debounce_seconds 小于等于 0 时与 value_changed 同步发出。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">value: 防抖后的值。</tag>
				<tag name="schema">value: Variant editor value read from the active control.</tag>
				<tag name="since">8.0.0</tag>
			</tags>
		</member>
		<member kind="signal" name="value_parse_failed">
			<signature>signal value_parse_failed(text: String, error_message: String)</signature>
			<description>Array/Dictionary JSON 输入解析失败时发出。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">text: 用户输入的原始文本。</tag>
				<tag name="param">error_message: JSON 解析错误说明。</tag>
			</tags>
		</member>
	</signals>
