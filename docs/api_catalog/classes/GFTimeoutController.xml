			<tags>
				<tag name="api">public</tag>
				<tag name="since">7.0.0</tag>
			</tags>
		</member>
		<member kind="property" name="process_in_physics">
			<signature>var process_in_physics: bool = false</signature>
			<description>是否在物理帧中处理超时计时器。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="since">7.0.0</tag>
			</tags>
