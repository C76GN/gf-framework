			<signature>func is_active() -&gt; bool:</signature>
			<description>判断当前是否存在待触发的超时计划。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">存在活动超时计划时返回 true。</tag>
				<tag name="since">7.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="is_timeout">
			<signature>func is_timeout() -&gt; bool:</signature>
