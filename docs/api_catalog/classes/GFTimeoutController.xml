			<signature>func cancel(reason: StringName = &amp;"cancelled", metadata: Dictionary = {}) -&gt; bool:</signature>
			<description>主动取消当前 token。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="param">reason: 取消原因。</tag>
				<tag name="param">metadata: 取消上下文。</tag>
				<tag name="return">首次取消时返回 true。</tag>
				<tag name="schema">metadata: Dictionary，包含调用方定义的取消上下文。</tag>
				<tag name="since">7.0.0</tag>
