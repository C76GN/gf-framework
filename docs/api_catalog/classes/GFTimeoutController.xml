			<signature>func get_elapsed_msec() -&gt; int:</signature>
			<description>获取当前超时计划已运行毫秒数。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="return">从 start_seconds 开始经过的毫秒数；未启动时为 0。</tag>
				<tag name="since">7.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="dispose">
			<signature>func dispose() -&gt; void:</signature>
			<description>释放当前计划和连接。</description>
			<tags>
				<tag name="api">public</tag>
				<tag name="since">7.0.0</tag>
			</tags>
		</member>
		<member kind="method" name="get_debug_snapshot">
			<signature>func get_debug_snapshot() -&gt; Dictionary:</signature>
			<description>获取超时控制器调试快照。</description>
			<tags>
				<tag name="api">public</tag>
