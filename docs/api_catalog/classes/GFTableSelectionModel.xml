				<tag name="param">to_row_id: 范围终点。</tag>
				<tag name="param">additive: 为 true 时保留现有选择并叠加范围。</tag>
				<tag name="return">状态发生变化时返回 true。</tag>
				<tag name="schema">ordered_row_ids: Array，当前顺序中的稳定行 ID。</tag>
				<tag name="schema">from_row_id: Variant，范围起点行 ID。</tag>
				<tag name="schema">to_row_id: Variant，范围终点行 ID。</tag>
				<tag name="since">5.2.0</tag>
			</tags>
		</member>
