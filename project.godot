; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GF"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Gf="*uid://dftf1eh06apl0"

[debug]

gdscript/warnings/directory_rules={
"res://addons/gf": 1,
"res://addons/gut": 0,
"res://addons/gut/not_a_real_file": 0
}
gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1
gdscript/warnings/return_value_discarded=1
gdscript/warnings/missing_await=1

[editor]

run/main_run_args="--verbose"
naming/script_name_casing=2

[editor_plugins]

enabled=PackedStringArray("res://addons/gf/plugin.cfg", "res://addons/gut/plugin.cfg")

[gf]

extensions/enabled=Array[String]([])
extensions/selection_mode="default"
extensions/export_fail_on_disabled_references=true
project/installers=[]
extensions/auto_install_enabled_installers=true
project/installer_timeout_seconds=0.0

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
