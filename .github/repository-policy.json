{
  "schema_version": 4,
  "repository": "C76GN/gf-framework",
  "default_branch": "main",
  "development_branch": "develop",
  "cutover_release": "12.0.0",
  "development_api_baseline": {
    "tag": "12.0.0",
    "commit": "35793911cd0aa3c5e90348d145d88bff04c4223e"
  },
  "abandoned_release_tags": {},
  "internal_branch_pattern": "^(?:feat|fix|refactor|perf|docs|test|build|ci|chore|hotfix|release|codex)/[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$",
  "bot_branch_patterns": [
    "^dependabot/[a-z0-9](?:[a-z0-9._/-]*[a-z0-9])?$"
  ],
  "development_version_pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-dev\\.(0|[1-9][0-9]*)$",
  "required_status_checks": [
    "GF repository policy",
    "GF merge gate"
  ],
  "repository_settings": {
    "allow_auto_merge": true,
    "allow_merge_commit": false,
    "allow_rebase_merge": true,
    "allow_squash_merge": true,
    "delete_branch_on_merge": true
  },
  "branch_protection": {
    "allow_deletions": false,
    "allow_force_pushes": false,
    "dismiss_stale_reviews": true,
    "enforce_admins": true,
    "require_code_owner_reviews": false,
    "require_last_push_approval": false,
    "required_approving_review_count": 0,
    "required_conversation_resolution": true,
    "required_linear_history": true,
    "strict_status_checks": true
  }
}
