{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gf-framework.dev/schemas/project-snapshot-v5.json",
  "title": "GF Observed Project Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generator_version",
    "generated_at_utc",
    "project_root",
    "contract",
    "framework",
    "project",
    "agents",
    "drift"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 5},
    "generator_version": {"type": "string", "minLength": 1},
    "generated_at_utc": {"type": "string", "minLength": 1},
    "project_root": {"type": "string", "const": "."},
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "valid", "sha256", "issue_count", "schema_version", "current_schema_version", "migration_required", "migration_available"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "valid": {"type": "boolean"},
        "sha256": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
        "issue_count": {"type": "integer", "minimum": 0},
        "schema_version": {"type": "integer", "minimum": 0},
        "current_schema_version": {"type": "integer", "const": 2},
        "migration_required": {"type": "boolean"},
        "migration_available": {"type": "boolean"}
      }
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installed",
        "version",
        "catalog_framework_version",
        "catalog_matches_framework",
        "plugin_enabled",
        "packages",
        "package_state",
        "extensions",
        "capability_readiness"
      ],
      "properties": {
        "installed": {"type": "boolean"},
        "version": {"type": "string"},
        "catalog_framework_version": {"type": "string", "minLength": 1},
        "catalog_matches_framework": {"type": "boolean"},
        "plugin_enabled": {"type": "boolean"},
        "packages": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "package_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "lockfile_present", "valid", "issues"],
          "properties": {
            "source": {"type": "string", "enum": ["filesystem", "lockfile"]},
            "lockfile_present": {"type": "boolean"},
            "valid": {"type": "boolean"},
            "issues": {"type": "array", "items": {"type": "string"}}
          }
        },
        "extensions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "capability_readiness": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "decision_state", "owner", "status", "catalog_packages", "installed_catalog_packages", "recipe_all_of_packages", "recipe_all_of_package_count", "recipe_all_of_packages_truncated", "missing_recipe_all_of_packages", "missing_recipe_all_of_package_count", "missing_recipe_all_of_packages_truncated", "recipe_any_of_package_groups", "recipe_any_of_package_group_count", "recipe_any_of_package_groups_truncated", "unsatisfied_recipe_any_of_package_groups", "unsatisfied_recipe_any_of_package_group_count", "unsatisfied_recipe_any_of_package_groups_truncated", "observed_classes", "observed_class_count", "observed_classes_truncated", "observation_complete", "recipes", "acceptance_count"],
            "properties": {
              "id": {"type": "string", "maxLength": 120, "pattern": "^[a-z][a-z0-9_-]*$"},
              "decision_state": {"type": "string", "enum": ["pending_review", "confirmed"]},
              "owner": {"type": "string", "maxLength": 120, "pattern": "^[a-z][a-z0-9_-]*$"},
              "status": {"type": "string", "enum": ["unavailable", "incomplete", "observed", "available_unobserved", "evidence_incomplete"]},
              "catalog_packages": {"type": "array", "maxItems": 30, "uniqueItems": true, "items": {"type": "string"}},
              "installed_catalog_packages": {"type": "array", "maxItems": 30, "uniqueItems": true, "items": {"type": "string"}},
              "recipe_all_of_packages": {"type": "array", "maxItems": 40, "uniqueItems": true, "items": {"type": "string"}},
              "recipe_all_of_package_count": {"type": "integer", "minimum": 0},
              "recipe_all_of_packages_truncated": {"type": "boolean"},
              "missing_recipe_all_of_packages": {"type": "array", "maxItems": 40, "uniqueItems": true, "items": {"type": "string"}},
              "missing_recipe_all_of_package_count": {"type": "integer", "minimum": 0},
              "missing_recipe_all_of_packages_truncated": {"type": "boolean"},
              "recipe_any_of_package_groups": {
                "type": "array",
                "maxItems": 40,
                "items": {"type": "array", "minItems": 2, "maxItems": 20, "uniqueItems": true, "items": {"type": "string"}}
              },
              "recipe_any_of_package_group_count": {"type": "integer", "minimum": 0},
              "recipe_any_of_package_groups_truncated": {"type": "boolean"},
              "unsatisfied_recipe_any_of_package_groups": {
                "type": "array",
                "maxItems": 40,
                "items": {"type": "array", "minItems": 2, "maxItems": 20, "uniqueItems": true, "items": {"type": "string"}}
              },
              "unsatisfied_recipe_any_of_package_group_count": {"type": "integer", "minimum": 0},
              "unsatisfied_recipe_any_of_package_groups_truncated": {"type": "boolean"},
              "observed_classes": {"type": "array", "maxItems": 80, "uniqueItems": true, "items": {"type": "string", "pattern": "^GF[A-Za-z0-9_]+$"}},
              "observed_class_count": {"type": "integer", "minimum": 0},
              "observed_classes_truncated": {"type": "boolean"},
              "observation_complete": {"type": "boolean"},
              "recipes": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}},
              "acceptance_count": {"type": "integer", "minimum": 0, "maximum": 30}
            }
          }
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["godot_features", "script_count", "scanned_script_count", "scanned_script_bytes", "test_script_count", "source_scan_truncated", "source_scan_truncation_reason", "source_scan_complete", "skipped_large_script_count", "unreadable_script_count", "unsafe_script_path_count", "unsafe_directory_count", "gf_api_usage", "test_gf_api_usage", "declared_roots", "module_dependency_analysis"],
      "properties": {
        "godot_features": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "script_count": {"type": "integer", "minimum": 0},
        "scanned_script_count": {"type": "integer", "minimum": 0},
        "scanned_script_bytes": {"type": "integer", "minimum": 0},
        "test_script_count": {"type": "integer", "minimum": 0},
        "source_scan_truncated": {"type": "boolean"},
        "source_scan_truncation_reason": {"type": "string", "enum": ["", "script_count", "byte_budget"]},
        "source_scan_complete": {"type": "boolean"},
        "skipped_large_script_count": {"type": "integer", "minimum": 0},
        "unreadable_script_count": {"type": "integer", "minimum": 0},
        "unsafe_script_path_count": {"type": "integer", "minimum": 0},
        "unsafe_directory_count": {"type": "integer", "minimum": 0},
        "gf_api_usage": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "test_gf_api_usage": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "declared_roots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["module_id", "path", "exists"],
            "properties": {
              "module_id": {"type": "string"},
              "path": {"type": "string"},
              "exists": {"type": "boolean"}
            }
          }
        },
        "module_dependency_analysis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "complete",
            "truncated",
            "supported_extensions",
            "scanned_file_count",
            "scanned_byte_count",
            "oversized_file_count",
            "unreadable_file_count",
            "missing_root_count",
            "unsafe_path_count",
            "declared_owned_resource_count",
            "missing_owned_resource_count",
            "unsafe_owned_resource_count",
            "owned_resources",
            "owned_resource_reference_count",
            "owned_resource_references_truncated",
            "owned_resource_references",
            "unowned_reference_count",
            "unowned_references_truncated",
            "unowned_references",
            "module_file_counts",
            "ambiguous_class_name_count",
            "ambiguous_class_names_truncated",
            "ambiguous_class_names",
            "edges",
            "cycles"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["not_configured", "contract_invalid", "complete", "incomplete", "truncated"]
            },
            "complete": {"type": "boolean"},
            "truncated": {"type": "boolean"},
            "supported_extensions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^\\.[a-z]+$"}
            },
            "scanned_file_count": {"type": "integer", "minimum": 0},
            "scanned_byte_count": {"type": "integer", "minimum": 0},
            "oversized_file_count": {"type": "integer", "minimum": 0},
            "unreadable_file_count": {"type": "integer", "minimum": 0},
            "missing_root_count": {"type": "integer", "minimum": 0},
            "unsafe_path_count": {"type": "integer", "minimum": 0},
            "declared_owned_resource_count": {"type": "integer", "minimum": 0, "maximum": 100},
            "missing_owned_resource_count": {"type": "integer", "minimum": 0, "maximum": 100},
            "unsafe_owned_resource_count": {"type": "integer", "minimum": 0, "maximum": 100},
            "owned_resources": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "status"],
                "properties": {
                  "path": {"type": "string", "pattern": "^res://.+$"},
                  "status": {"type": "string", "enum": ["available", "missing", "unsafe"]}
                }
              }
            },
            "owned_resource_reference_count": {"type": "integer", "minimum": 0},
            "owned_resource_references_truncated": {"type": "boolean"},
            "owned_resource_references": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["source_path", "target_path", "line"],
                "properties": {
                  "source_path": {"type": "string", "pattern": "^res://.+$"},
                  "target_path": {"type": "string", "pattern": "^res://.+$"},
                  "line": {"type": "integer", "minimum": 1}
                }
              }
            },
            "unowned_reference_count": {"type": "integer", "minimum": 0},
            "unowned_references_truncated": {"type": "boolean"},
            "unowned_references": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["source_path", "target_path", "line"],
                "properties": {
                  "source_path": {"type": "string", "pattern": "^res://.+$"},
                  "target_path": {"type": "string", "pattern": "^res://.+$"},
                  "line": {"type": "integer", "minimum": 1}
                }
              }
            },
            "module_file_counts": {
              "type": "array",
              "maxItems": 120,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["module_id", "file_count", "class_name_count"],
                "properties": {
                  "module_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
                  "file_count": {"type": "integer", "minimum": 0},
                  "class_name_count": {"type": "integer", "minimum": 0}
                }
              }
            },
            "ambiguous_class_name_count": {"type": "integer", "minimum": 0},
            "ambiguous_class_names_truncated": {"type": "boolean"},
            "ambiguous_class_names": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["class_name", "paths"],
                "properties": {
                  "class_name": {"type": "string", "minLength": 1},
                  "paths": {
                    "type": "array",
                    "minItems": 2,
                    "uniqueItems": true,
                    "items": {"type": "string", "pattern": "^res://.+$"}
                  }
                }
              }
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["source_module", "target_module", "reference_count", "kinds", "evidence_truncated", "evidence"],
                "properties": {
                  "source_module": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
                  "target_module": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
                  "reference_count": {"type": "integer", "minimum": 1},
                  "kinds": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "description": "Observed reference mechanisms. generated_output identifies a resource-path literal owned by a target-only generated module.",
                    "items": {"type": "string", "enum": ["class_name", "resource_path", "generated_output"]}
                  },
                  "evidence_truncated": {"type": "boolean"},
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 12,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["source_path", "target_path", "kind", "symbol", "line"],
                      "properties": {
                        "source_path": {"type": "string", "pattern": "^res://.+$"},
                        "target_path": {"type": "string", "pattern": "^res://.+$"},
                        "kind": {
                          "type": "string",
                          "description": "Reference mechanism for this bounded evidence item.",
                          "enum": ["class_name", "resource_path", "generated_output"]
                        },
                        "symbol": {"type": "string", "minLength": 1},
                        "line": {"type": "integer", "minimum": 1}
                      }
                    }
                  }
                }
              }
            },
            "cycles": {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}
              }
            }
          }
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installed", "drifted"],
      "properties": {
        "installed": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "drifted": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "drift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "error_count", "warning_count", "issues"],
      "properties": {
        "ok": {"type": "boolean"},
        "error_count": {"type": "integer", "minimum": 0},
        "warning_count": {"type": "integer", "minimum": 0},
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["severity", "code", "path", "message"],
            "properties": {
              "severity": {"type": "string", "enum": ["error", "warning"]},
              "code": {"type": "string"},
              "path": {"type": "string"},
              "message": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
